# Copy to .env and adjust. Paths may be relative to the project root.
# Windows 用户：本文件同样适用，路径写相对路径即可，不要写盘符。

APP_ENV=development
LOG_LEVEL=INFO
LOG_PATH=logs/system.log

CRM_STORE_PATH=data/crm_store.json
PRICING_RULES_PATH=data/pricing_rules.json
FREIGHT_RULES_PATH=data/freight_rules.json
COMPLIANCE_RULES_PATH=data/compliance_rules.json

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.2

# Optional Google Workspace auth. Leave blank to skip Google agents.
# Point this at your own credentials file; never commit the file itself.
#   macOS / Linux: ~/.config/gws/credentials.json
#   Windows:       %USERPROFILE%\.config\gws\credentials.json
GOOGLE_WORKSPACE_CLI_CLIENT_ID=
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET=
GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=

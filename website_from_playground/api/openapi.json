{
  "openapi": "3.0.3",
  "info": {
    "title": "Tongxi Fairy Lab Site Profile API",
    "version": "1.0.0",
    "description": "Public site profile and release discovery stubs for Tongxi Fairy Lab."
  },
  "paths": {
    "/api/release-manifest.json": {
      "get": {
        "summary": "Get latest Trade Assistant release manifest",
        "responses": {
          "200": {
            "description": "Release manifest returned"
          }
        }
      }
    },
    "/.well-known/agent.json": {
      "get": {
        "summary": "Get site profile metadata",
        "responses": {
          "200": {
            "description": "Site profile metadata returned"
          }
        }
      }
    }
  }
}
